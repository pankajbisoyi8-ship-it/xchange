# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL - Neon, Supabase, Railway, or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/partxchange?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="partxchange_super_secure_access_token_secret_minimum_32_characters_long_2026"
JWT_REFRESH_SECRET="partxchange_super_secure_refresh_token_secret_minimum_32_characters_long_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# CORS & Client
CLIENT_URL="http://localhost:5173"

# Uploads Configuration
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# Business Logic Defaults
COMMISSION_PERCENTAGE=5
DEFAULT_DELIVERY_FEE=200
