# ==============================================================================
# Vercel Deployment Environment Variables
# Copy these values into: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================

# Database Connection (Neon, Supabase, or Railway PostgreSQL)
# Note: Vercel serverless runs in the cloud and cannot connect to "localhost".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Authentication Secrets (Must be at least 16-32 characters long)
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Node Environment
NODE_ENV="production"

# Your Vercel production deployment domain (Update once deployed)
CLIENT_URL="https://your-project.vercel.app"

# Business Logic Defaults
COMMISSION_PERCENTAGE=5
DEFAULT_DELIVERY_FEE=200

